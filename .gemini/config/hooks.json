{
  "session-context": {
    "SessionStart": [
      {
        "type": "command",
        "command": "\"$HOME/.codex/hooks/bin/session_start_context\" --antigravity"
      }
    ]
  },
  "graphify-refresh": {
    "PostToolUse": [
      {
        "matcher": "^(run_command|write_to_file|replace_file_content|multi_replace_file_content)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/bin/graphify_update\" --antigravity"
          }
        ]
      }
    ]
  }
}
