{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/.codex/hooks/bin/go_quality fence",
            "statusMessage": "Waiting for Go quality baseline before edits",
            "timeout": 600,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "$HOME/.codex/hooks/bin/generated_code_guard",
            "statusMessage": "Checking for generated Go files",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^(apply_patch|Edit|Write)$"
      },
      {
        "hooks": [
          {
            "command": "$HOME/.codex/hooks/bin/subagent_exec_guard",
            "statusMessage": "Checking subagent command boundary",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/.codex/hooks/bin/go_quality edit",
            "statusMessage": "Formatting and fixing changed Go files",
            "timeout": 600,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "$HOME/.codex/hooks/bin/go_quality check",
            "statusMessage": "Checking new Go quality findings",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.codex/hooks/bin/go_quality baseline",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume)$"
      },
      {
        "hooks": [
          {
            "command": "$HOME/.codex/hooks/bin/session_start_context $HOME/.codex/hooks/bin/check_project",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "$HOME/.codex/hooks/bin/session_start_context skills-mgr list",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^(startup|compact|clear)$"
      },
      {}
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "$HOME/.codex/hooks/bin/session_start_context skills-mgr list",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
