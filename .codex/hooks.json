{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "$HOME/.codex/hooks/bin/session_start_context $HOME/.codex/hooks/bin/check_project",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(startup|compact|clear)$"
      },
      {
        "hooks": [
          {
            "command": "$HOME/.codex/hooks/bin/session_start_context cat $HOME/.codex/MAIN.md",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume|clear|compact)$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "$HOME/.codex/hooks/bin/ledger_stop_gate",
            "timeout": 600,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "$HOME/.codex/hooks/bin/capture_result_gate",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "$HOME/.codex/hooks/bin/session_start_context $HOME/.codex/hooks/bin/check_project",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "$HOME/.codex/hooks/bin/session_start_context cat $HOME/.codex/SUBAGENT.md",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "(^|[._])(apply_patch|exec_command|write_stdin|exec|wait)$|^(Bash|Edit|Write|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/bin/graphify_update",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
