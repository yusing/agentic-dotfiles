{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/.codex/hooks/bin/generated_code_guard",
            "statusMessage": "Checking for generated Go files",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^(apply_patch|Edit|Write)$"
      },
      {
        "hooks": [
          {
            "command": "$HOME/.codex/hooks/bin/subagent_exec_guard",
            "statusMessage": "Checking subagent command boundary",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "$HOME/.codex/hooks/bin/check_project",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "skills-mgr list",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^(startup|compact|clear)$"
      },
      {
        "matcher": "^(startup|compact|clear)$"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "skills-mgr list",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/bin/go_guidelines",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
