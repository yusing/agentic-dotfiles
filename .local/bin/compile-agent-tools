#!/bin/sh
# version: 1.1.0
# Rebuild changed user-owned helper and hook binaries for this machine.

set -eu

tool_home=${HOME:?HOME must be set}
local_bin=$tool_home/.local/bin
engine_source=$tool_home/.local/lib/compile-agent-tools/compile-agent-tools.ts
engine=$local_bin/compile-agent-tools-engine
cache_root=${XDG_CACHE_HOME:-"$tool_home/.cache"}/compile-agent-tools
wrapper_dir=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
wrapper=$wrapper_dir/$(basename "$0")

# Git hooks do not activate an interactive shell. Append setup-owned command
# locations only when needed so caller-selected tools keep precedence.
if ! command -v bun >/dev/null 2>&1 || ! command -v scriptc >/dev/null 2>&1; then
	PATH=$PATH:$tool_home/.local/share/mise/shims:$local_bin
	export PATH
fi
bun_path=$(command -v bun)
bun_identity=$bun_path:$("$bun_path" --version)
target_identity=$(uname -s)-$(uname -m)
mkdir -p "$cache_root"
state=$cache_root/bootstrap.digest
digest=$(
	{
		printf '%s\n' "bun=$bun_identity target=$target_identity flags=build--compile"
		git hash-object "$wrapper" "$engine_source"
		[ ! -f "$tool_home/.bunfig.toml" ] || git hash-object "$tool_home/.bunfig.toml"
	} | git hash-object --stdin
)

stored=
if [ -r "$state" ]; then
	IFS= read -r stored < "$state" || stored=
fi
if [ ! -x "$engine" ] || [ "$stored" != "$digest" ]; then
	build_temp=$engine.compile-agent-tools.$$
	state_temp=$state.tmp.$$
	cleanup() {
		rm -f "$build_temp" "$state_temp"
	}
	trap cleanup EXIT HUP INT TERM
	"$bun_path" build --compile --outfile="$build_temp" "$engine_source"
	chmod 755 "$build_temp"
	mv -f "$build_temp" "$engine"
	build_temp=
	printf '%s\n' "$digest" > "$state_temp"
	mv -f "$state_temp" "$state"
	state_temp=
	trap - EXIT HUP INT TERM
fi

exec "$engine" "$@"
