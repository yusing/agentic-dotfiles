#!/bin/sh
# version: 1.1.0
# Load each clip.png that clip-push sends over Taildrop into the X clipboard
# on $DISPLAY, so agents running over mosh can paste it with Ctrl+V.
set -eu

dir="${XDG_RUNTIME_DIR:-/tmp}/clip-recv"
mkdir -p "$dir"
: "${DISPLAY:?clip-recv needs DISPLAY (for example the Xvfb display :99)}"

while :; do
	# Exiting 0 here would look like a clean stop and hide the real failure,
	# so report why the wait ended. Taildrop needs `tailscale set --operator`.
	status=0
	tailscale file get --wait --conflict=overwrite "$dir" || status=$?
	[ "$status" -eq 0 ] || {
		printf 'clip-recv: tailscale file get failed (exit %s)\n' "$status" >&2
		exit "$status"
	}
	# xclip forks and keeps serving the image until the next one replaces it,
	# so it has the bytes once it returns and the file can go.
	if [ -s "$dir/clip.png" ]; then
		xclip -selection clipboard -t image/png -i "$dir/clip.png"
	fi
	# Taildrop writes whatever it was sent, under whatever name, so empty the
	# drop directory each round rather than only the file we recognise.
	rm -f "$dir"/* || :
done
