		"plan_mode_reasoning_effort",
		"sandbox_mode",
		"service_tier",
		"supports_websockets",
		"tool_output_token_limit",
	]);
	const sections = new Set([
		"analytics",
		"features",
		"features.multi_agent_v2",
		"feedback",
		"mcp_servers.openaiDeveloperDocs",
		"memories",
		"notice",
		"notice.model_migrations",
		"skills",
		"tui",
	]);
	return projectToml(text, topLevel, section => sections.has(section));
}

function projectGrokConfig(text: string): string {
	const sections = ["cli", "disabled_mcp_tools", "features", "harness", "mcp_servers.context7", "models", "telemetry", "ui"];
	return projectToml(text, new Set(["disabled_mcp_servers"]), section =>
		sections.some(allowed => section === allowed || section.startsWith(`${allowed}.`)),
	);
}

function fishCodeOutsideQuotes(line: string, initialQuote: "'" | '"' | undefined): { code: string; quote: "'" | '"' | undefined } {
	let code = "";
	let quote = initialQuote;
	for (let index = 0; index < line.length; index++) {
		const character = line[index];
		if (quote) {
			if (character === "\\") {
				index++;
				continue;
			}
			if (character === quote) quote = undefined;
			continue;
		}
		if (character === "#") break;
		if (character === "'" || character === '"') {
			quote = character;
			code += " ";
			continue;
		}
		code += character;
	}
	return { code, quote };
}

function removeFishBlocks(text: string): string {
	const lines = text.split(/\r?\n/);
	const output: string[] = [];
	let depth = 0;
	let quote: "'" | '"' | undefined;
	for (const line of lines) {
		const privateIf = /^\s*if\b/.test(line) && PRIVATE_LINE_TOKENS.some(token => line.toLowerCase().includes(token.toLowerCase()));
		if (depth === 0 && (/^\s*function\s+(install_my_ca|claude-use|claude-config-edit)\b/.test(line) || privateIf)) {
			depth = 1;
			quote = undefined;
			continue;
		}
		if (depth > 0) {
			const visible = fishCodeOutsideQuotes(line, quote);
			quote = visible.quote;
			if (/^\s*(begin|for|function|if|switch|while)\b/.test(visible.code)) depth++;
			depth += (visible.code.match(/;\s*(?:and|or)\s+begin\b/g) ?? []).length;
			if (/^\s*end\b/.test(visible.code)) depth--;
			continue;
		}
		output.push(line);
	}
	if (depth !== 0 || quote) throw new Error("unbalanced filtered Fish block");
	return output.join("\n");
}

function removeBraceFunction(text: string, names: Set<string>): string {
	const lines = text.split(/\r?\n/);
	const output: string[] = [];
	let depth = 0;
	for (const line of lines) {
		const start = depth === 0 ? line.match(/^\s*([A-Za-z0-9_-]+)\(\)\s*\{/) : undefined;
		if (start && names.has(start[1])) depth = 1;
		if (depth > 0) {
			if (!start) depth += (line.match(/\{/g) ?? []).length;
			depth -= (line.match(/\}/g) ?? []).length;
			continue;
		}
		output.push(line);
	}
	if (depth !== 0) throw new Error("unbalanced filtered shell function");
	return output.join("\n");
}

function removePrivateShellIfBlocks(text: string): string {
	const lines = text.split(/\r?\n/);
	const output: string[] = [];
	let depth = 0;
	for (const line of lines) {
		const privateIf = /^\s*if\b/.test(line) && PRIVATE_LINE_TOKENS.some(token => line.toLowerCase().includes(token.toLowerCase()));
		if (depth === 0 && privateIf) {
			depth = 1;
			continue;
		}
		if (depth > 0) {
			if (/^\s*if\b/.test(line)) depth++;
			if (/^\s*fi\b/.test(line)) depth--;
			continue;
		}
		output.push(line);
	}
	if (depth !== 0) throw new Error("unbalanced filtered private shell block");
	return output.join("\n");
}

function projectShell(path: string, text: string): string {
	let projected = text;
	if (path.endsWith(".fish")) projected = removeFishBlocks(projected);
	if (path === ".bashrc" || path.endsWith(".zsh") || path === ".zshrc") {
		projected = removeBraceFunction(projected, new Set(["install_my_ca", "claude-use", "claude-config-edit"]));
		projected = removePrivateShellIfBlocks(projected);
	}
	const lines = projected
		.split(/\r?\n/)
		.filter(line => !PRIVATE_LINE_TOKENS.some(token => line.toLowerCase().includes(token.toLowerCase())))
		.filter(line => !(path === ".yabairc" && line.includes("trgame.exe")))
		.filter(line => !(path === ".gitignore_global" && line.trim() === ".kilo/"));
	return `${lines.join("\n").trimEnd()}\n`;
}

function projectGitignore(text: string, projectedPaths: Set<string>): string {
	const preamble: string[] = [];
	for (const line of text.split(/\r?\n/)) {
		const trimmed = line.trim();
		if (!trimmed || trimmed.startsWith("#") || trimmed === "*" || trimmed === "__pycache__") {
			preamble.push(line);
			continue;
		}
		break;
	}
	while (preamble.at(-1) === "") preamble.pop();

	// Source un-ignores private-only paths. Keep only files that reached this
	// projection, plus their parent directories so Git will still enter them.
	const rules = new Set<string>();
	for (const path of projectedPaths) {
		const parts = path.split("/");
		let prefix = "";
		for (let index = 0; index < parts.length; index++) {
			prefix = prefix ? `${prefix}/${parts[index]}` : parts[index];
			rules.add(index < parts.length - 1 ? `!/${prefix}/` : `!/${prefix}`);
		}
	}
	return `${[...preamble, "", ...[...rules].sort((left, right) => left.slice(2).localeCompare(right.slice(2)))].join("\n")}\n`;
}

function projectGitConfig(text: string): string {
	const output: string[] = [];
	let keepSection = true;
	for (const line of text.split(/\r?\n/)) {
		const header = line.match(/^\s*\[([^\]]+)\]/);
		if (header) keepSection = !["user", "coderabbit"].includes(header[1].trim());
		if (!keepSection || /^\s*signingkey\s*=/.test(line)) continue;
		output.push(line);
	}
	return `${output.join("\n").trimEnd()}\n`;
}

function projectMarkdown(path: string, text: string): string {
	if (path === "AGENTS.md") {
		return PUBLIC_PROJECT_GUIDANCE;
	}
	let projected = text;
	if (path === "CONTEXT-HOOK-OWNERS.md") {
		projected = projected
			.replace(
				/root-session project\s+context, skill inventory, and Herdr\s+reporting/,
				"root-session project\n  context and skill inventory",
			)
			.replace(/;\s*`\.codex\/herdr-agent-state\.sh` reports[\s\S]*?edited directly\.\n/, ".\n");
		projected = projected.replace(/\s*FIXME: Port the `SubagentStart`[\s\S]*?delivery\.\n/, "\n");
	}
	if (path === "CONTEXT-CODEX-LIFECYCLE.md") {
		projected = projected
			.replace(
				/`\.codex\/hooks\/check_project`, the automatic skill-inventory\s+reporter, and the single Herdr\s+session reporter/,
				"`.codex/hooks/check_project` and the automatic\n   skill-inventory reporter",
			)
			.replace(
				/project context, current skill metadata, and\s+session reporting\s+without selecting/,
				"project context and current skill metadata\n   without selecting",
			);
	}
	if (path === "CONTEXT-INSTRUCTION-SURFACES.md") {
		projected = projected
			.split(/\r?\n/)
			.filter(line => ![".kilocode/", ".omp/", ".pi/"].some(token => line.includes(token)))
			.join("\n");
	}
	return `${projected.trimEnd()}\n`;
}

function transformText(path: string, text: string, privateHomes: string[]): string {
	// The helper is part of its own output. Preserve its deny rules verbatim rather than
	// rewriting the private examples those rules are responsible for detecting.
	if (path === COMMAND_PATH) return text;
	let projected = text;
	if (path === ".codex/config.toml") projected = projectCodexConfig(projected);
	else if (path === ".grok/config.toml") projected = projectGrokConfig(projected);
	else if (path === ".claude/settings.json") projected = projectClaudeSettings(projected);
	else if (path === ".codex/hooks.json") projected = encodeJson(removeGeneratedHooks(JSON.parse(projected)));
	else if (path === ".config/zed/settings.json") projected = projectZedSettings(projected);
	else if (path === ".gitconfig") projected = projectGitConfig(projected);
	else if (path.endsWith(".md")) projected = projectMarkdown(path, projected);
	else if ([".bashrc", ".gitignore_global", ".tmux.conf", ".yabairc", ".zshrc"].includes(path) || path.endsWith(".fish") || path.endsWith(".zsh")) {
		projected = projectShell(path, projected);
	}
	for (const privateHome of privateHomes) projected = projected.replaceAll(privateHome, "$HOME");
	// Committed content can retain Linux home paths from a different host than the
	// machine running the projection.
	projected = projected.replaceAll(/(?<![A-Za-z0-9._~\/-])\/home\/[A-Za-z0-9._-]+/g, "$HOME");
	return projected;
}

function isTextPath(path: string): boolean {
	if (TEXT_PATHS_WITHOUT_STANDARD_EXTENSIONS.has(path)) return true;
	const name = path.split("/").at(-1) ?? path;
	if (!name.includes(".")) return path === COMMAND_PATH || path.startsWith(".local/bin/") || path.startsWith(".codex/hooks/");
	return TEXT_EXTENSIONS.has(`.${name.split(".").at(-1)!.toLowerCase()}`);
}

function publicContentFailure(path: string, text: string): string | undefined {
	if (path === COMMAND_PATH) return undefined;
	const checks: Array<[RegExp, string]> = [
		[/\$HOME\/(?:projects|Projects)\//i, "private project path"],
		[/\b(?:10\.|192\.168\.|172\.(?:1[6-9]|2\d|3[01])\.)\d{1,3}\.\d{1,3}/, "private IP address"],
		[/\b[a-z0-9.-]+\.pve(?::\d+)?\b/i, "private hostname"],
		[/ANTHROPIC_AUTH_TOKEN|OPENAI_EMBEDDING_|APPRISE_URL|masterpassword/i, "private credential configuration"],
		[/-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/, "private key"],
		[/spawn-codex|codex-auto-resume|\bcodex-herdr\b/, "removed Codex launcher"],
		[/herdr-agent-state\.sh/, "generated Herdr reporter"],
		[/\.omp\/|\.pi\/|\.kilocode\//, "excluded agent family"],
		[/inshellisense/i, "excluded tool"],
	];
	for (const [pattern, label] of checks) if (pattern.test(text)) return label;

	if (path.endsWith(".json") || path.endsWith(".toml") || path.endsWith(".yml") || path.endsWith(".yaml") || path.startsWith(".config/") || path.startsWith(".local/bin/")) {
		if (/(?:^|[^A-Za-z0-9_-])["']?(?:api[_-]?key|auth[_-]?token|password|secret)["']?\s*[:=]\s*["']?(?!\$|<|env\b|false\b|null\b|redacted\b)[^\s"']+/im.test(text)) {
			return "literal credential-like value";
		}
	}
	return undefined;
}

function symlinkStaysInside(path: string, target: string): boolean {
	if (isAbsolute(target)) return false;
	const root = resolve("/projection");
	const resolved = resolve(root, dirname(path), target);
	return resolved === root || resolved.startsWith(`${root}${sep}`);
}

function buildProjection(source: string, commit: string): Map<string, ProjectedEntry> {
	const projection = new Map<string, ProjectedEntry>();
	const userName = basename(homedir());
	const privateHomes = [...new Set([source, homedir(), join("/Users", userName)])]
		.filter(path => path !== resolve("/"))
		.sort((left, right) => right.length - left.length);
	for (const entry of listTree(source, commit)) {
		if (!isIncludedPath(entry.path) || isExcludedPath(entry.path)) continue;
		assertRelativePath(entry.path);
		const content = git(source, ["cat-file", "blob", entry.oid]);
		if (entry.mode === "120000") {
			projection.set(entry.path, { kind: "symlink", target: content.toString("utf8") });
			continue;
		}
		const projected = isTextPath(entry.path)
			? Buffer.from(transformText(entry.path, content.toString("utf8"), privateHomes))
			: content;
		projection.set(entry.path, { kind: "file", content: projected, executable: entry.mode === "100755" });
	}

	for (const required of ["AGENTS.md", COMMAND_PATH]) {
		if (!projection.has(required)) throw new Error(`source revision does not contain required projected path: ${required}`);
	}
	const gitignore = projection.get(".gitignore");
	if (gitignore?.kind === "file") {
		projection.set(".gitignore", {
			kind: "file",
			content: Buffer.from(projectGitignore(gitignore.content.toString("utf8"), new Set(projection.keys()))),
			executable: gitignore.executable,
		});
	}
	return projection;
}

function validateProjection(projection: Map<string, ProjectedEntry>): void {
	for (const [path, entry] of projection) {
		assertRelativePath(path);
		if (isExcludedPath(path)) throw new Error(`excluded test or evaluation path reached projection: ${path}`);
		if (entry.kind === "symlink") {
			if (!symlinkStaysInside(path, entry.target)) throw new Error(`symlink escapes projection: ${path} -> ${entry.target}`);
			continue;
		}
		if (!isTextPath(path)) continue;
		const failure = publicContentFailure(path, entry.content.toString("utf8"));
		if (failure) throw new Error(`${path} contains ${failure}`);
	}
}

function outputManifest(commit: string, projection: Map<string, ProjectedEntry>): OutputManifest {
	const outputs = [...projection.entries()]
		.sort(([left], [right]) => left.localeCompare(right))
		.map(([path, entry]): OutputRecord => {
			if (entry.kind === "symlink") return { path, kind: "symlink", target: entry.target };
			return {
				path,
				kind: "file",
				sha256: sha256(entry.content),
				executable: entry.executable,
			};
		});
	return { schemaVersion: 1, sourceCommit: commit, outputs };
}

function sha256(content: Uint8Array): string {
	const hasher = new Bun.CryptoHasher("sha256");
	hasher.update(content);
	return hasher.digest("hex");
}

async function writeStagedTree(stage: string, projection: Map<string, ProjectedEntry>, manifest: OutputManifest): Promise<void> {
	for (const [path, entry] of projection) {
		const destination = join(stage, path);
		await mkdir(dirname(destination), { recursive: true });
		if (entry.kind === "symlink") await symlink(entry.target, destination);
		else {
			await Bun.write(destination, entry.content);
			await chmod(destination, entry.executable ? 0o755 : 0o644);
		}
	}
	await Bun.write(join(stage, OUTPUT_MANIFEST_PATH), encodeJson(manifest));
}

async function existingManifest(destination: string): Promise<OutputManifest | undefined> {
	try {
		const value = objectValue(JSON.parse(await Bun.file(join(destination, OUTPUT_MANIFEST_PATH)).text()), OUTPUT_MANIFEST_PATH);
		if (value.schemaVersion !== 1 || !Array.isArray(value.outputs)) throw new Error("unsupported generated manifest");
		return value as OutputManifest;
	} catch (error) {
		if ((error as NodeJS.ErrnoException).code === "ENOENT") return undefined;
		throw error;
	}
}

async function pathExists(path: string): Promise<boolean> {
	try {
		await lstat(path);
		return true;
	} catch (error) {
		if ((error as NodeJS.ErrnoException).code === "ENOENT") return false;
		throw error;
	}
}

function destinationPath(root: string, path: string): string {
	assertRelativePath(path);
	const output = resolve(root, path);
	if (!output.startsWith(`${root}${sep}`)) throw new Error(`projection path escapes destination: ${path}`);
	return output;
}

async function assertSafeParents(root: string, path: string): Promise<void> {
	const parentParts = dirname(path).split("/").filter(part => part !== ".");
	let current = root;
	for (const part of parentParts) {
		current = join(current, part);
		try {
			const stat = await lstat(current);
			if (stat.isSymbolicLink() || !stat.isDirectory()) throw new Error(`destination parent is not a directory: ${current}`);
		} catch (error) {
			if ((error as NodeJS.ErrnoException).code === "ENOENT") return;
			throw error;
		}
	}
}

async function sameEntry(path: string, entry: ProjectedEntry): Promise<boolean> {
	try {
		const stat = await lstat(path);
		if (entry.kind === "symlink") return stat.isSymbolicLink() && (await readlink(path)) === entry.target;
		if (!stat.isFile()) return false;
		const content = Buffer.from(await Bun.file(path).arrayBuffer());
		return content.equals(entry.content) && Boolean(stat.mode & 0o111) === entry.executable;
	} catch (error) {
		if ((error as NodeJS.ErrnoException).code === "ENOENT") return false;
		throw error;
	}
}

async function atomicInstall(staged: string, destination: string, path: string, entry: ProjectedEntry): Promise<void> {
	const target = destinationPath(destination, path);
	await assertSafeParents(destination, path);
	await mkdir(dirname(target), { recursive: true });
	await assertSafeParents(destination, path);
	const temporary = join(dirname(target), `.${path.split("/").at(-1)}.project-public-config.${randomUUIDv7()}`);
	try {
		if (entry.kind === "symlink") await symlink(entry.target, temporary);
		else {
			await Bun.write(temporary, Bun.file(join(staged, path)));
			await chmod(temporary, entry.executable ? 0o755 : 0o644);
		}
		try {
			const stat = await lstat(target);
			if (stat.isDirectory() && !stat.isSymbolicLink()) throw new Error(`generated path is an existing directory: ${path}`);
		} catch (error) {
			if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
		}
		await rename(temporary, target);
		if (entry.kind === "file") await chmod(target, entry.executable ? 0o755 : 0o644);
	} catch (error) {
		await rm(temporary, { force: true });
		throw error;
	}
}

async function removeStalePath(destination: string, path: string): Promise<void> {
	const target = destinationPath(destination, path);
	await assertSafeParents(destination, path);
	try {
		const stat = await lstat(target);
		if (stat.isDirectory() && !stat.isSymbolicLink()) throw new Error(`refusing to delete stale generated directory: ${path}`);
		await unlink(target);
	} catch (error) {
		if ((error as NodeJS.ErrnoException).code === "ENOENT") return;
		throw error;
	}

	let parent = dirname(target);
	while (parent !== destination) {
		try {
			await rmdir(parent);
		} catch (error) {
			if (["ENOTEMPTY", "ENOENT"].includes((error as NodeJS.ErrnoException).code ?? "")) break;
			throw error;
		}
		parent = dirname(parent);
	}
}

async function matchesRecord(destination: string, record: OutputRecord): Promise<boolean> {
	const path = destinationPath(destination, record.path);
	try {
		const stat = await lstat(path);
		if (record.kind === "symlink") return stat.isSymbolicLink() && typeof record.target === "string" && (await readlink(path)) === record.target;
		if (!stat.isFile() || typeof record.sha256 !== "string") return false;
		return sha256(new Uint8Array(await Bun.file(path).arrayBuffer())) === record.sha256;
	} catch (error) {
		if ((error as NodeJS.ErrnoException).code === "ENOENT") return true;
		throw error;
	}
}

async function synchronize(destination: string, staged: string, projection: Map<string, ProjectedEntry>, manifest: OutputManifest): Promise<{ changed: number; removed: number }> {
	await mkdir(destination, { recursive: true });
	const destinationStat = await lstat(destination);
	if (destinationStat.isSymbolicLink() || !destinationStat.isDirectory()) throw new Error("destination must be a directory, not a symlink");
	const previous = await existingManifest(destination);
	const previousOutputs = new Map((previous?.outputs ?? []).map(output => {
		assertRelativePath(output.path);
		return [output.path, output];
	}));
	const previouslyOwned = new Set(previousOutputs.keys());
	previouslyOwned.add(OUTPUT_MANIFEST_PATH);

	for (const path of projection.keys()) {
		const target = destinationPath(destination, path);
		await assertSafeParents(destination, path);
		if (!previouslyOwned.has(path) && (await pathExists(target))) {
			throw new Error(`destination path is not owned by the projection: ${path}`);
		}
	}
	const staleOutputs = [...previousOutputs.values()].filter(
		output => output.path !== OUTPUT_MANIFEST_PATH && !projection.has(output.path),
	);
	for (const record of staleOutputs) {
		if (!(await matchesRecord(destination, record))) {
			throw new Error(`stale generated path was modified outside the projection: ${record.path}`);
		}
	}

	let changed = 0;
	for (const [path, entry] of projection) {
		const target = destinationPath(destination, path);
		if (await sameEntry(target, entry)) continue;
		await atomicInstall(staged, destination, path, entry);
		changed++;
	}

	let removed = 0;
	for (const record of staleOutputs) {
		await removeStalePath(destination, record.path);
		removed++;
	}

	const manifestEntry: ProjectedEntry = { kind: "file", content: Buffer.from(encodeJson(manifest)), executable: false };
	await atomicInstall(staged, destination, OUTPUT_MANIFEST_PATH, manifestEntry);
	return { changed, removed };
}

async function main(): Promise<void> {
	const options = parseArgs(process.argv.slice(2));
	if (options.source === options.destination) throw new Error("source and destination must be different directories");
	if ([resolve("/"), resolve(homedir())].includes(options.destination)) {
		throw new Error("destination must not be the filesystem root or home directory");
	}

	console.error(`Resolving ${options.revision} in ${options.source}`);
	const commit = git(options.source, ["rev-parse", "--verify", `${options.revision}^{commit}`]).toString("utf8").trim();
	const projection = buildProjection(options.source, commit);
	validateProjection(projection);
	console.error(`Projected and validated ${projection.size} paths from ${commit.slice(0, 12)}`);

	await mkdir(dirname(options.destination), { recursive: true });
	const stage = await mkdtemp(join(tmpdir(), "project-public-config-"));
	try {
		const manifest = outputManifest(commit, projection);
		await writeStagedTree(stage, projection, manifest);
		const result = await synchronize(options.destination, stage, projection, manifest);
		console.error(`Synchronized ${result.changed} changed paths and removed ${result.removed} stale paths`);
	} finally {
		await rm(stage, { recursive: true, force: true });
	}
}

main().catch(error => {
	console.error(`project-public-config: ${error instanceof Error ? error.message : String(error)}`);
	process.exitCode = 1;
});
