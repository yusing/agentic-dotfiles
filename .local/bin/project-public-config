type TreeEntry = {
	mode: string;
	oid: string;
	path: string;
};

type ProjectedEntry =
	| { kind: "file"; content: Buffer; executable: boolean }
	| { kind: "symlink"; target: string };

type OutputRecord = {
	path: string;
	kind: "file" | "symlink";
	sha256?: string;
	target?: string;
	executable?: boolean;
};

type OutputManifest = {
	schemaVersion: 1;
	sourceCommit: string;
	outputs: OutputRecord[];
};

type Options = {
	destination: string;
	revision: string;
	source: string;
};

