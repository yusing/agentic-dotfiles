const PUBLIC_PROJECT_GUIDANCE = `--- project-doc ---

# Repository guidance

## Scope

This is a generated, public, read-only projection of authored agent and shell configuration.
The private source repository owns changes. The projection helper overwrites generated paths,
so do not treat edits made only in this repository as authoritative.

## Context index

- Instruction surfaces: load \`CONTEXT-INSTRUCTION-SURFACES.md\` when locating static prompts,
  skills, or native Codex, Claude, and Grok roles.
- Hook architecture: load \`CONTEXT-HOOK-ARCHITECTURE.md\` when inspecting hook registration or
  event coverage.
- Hook owners: load \`CONTEXT-HOOK-OWNERS.md\` when locating an included hook or shared hook
  infrastructure.
- Codex lifecycle: load \`CONTEXT-CODEX-LIFECYCLE.md\` when work crosses Codex lifecycle events.
- Grok port: load \`CONTEXT-GROK-HOOK-PORT.md\` for the Grok Codex-hook adapter.
- Claude port: load \`CONTEXT-CLAUDE-AGENT-PORT.md\` for Claude roles also consumed by Grok.
- Shell configuration: load \`CONTEXT-SHELL.md\` before changing Bash, Zsh, or Fish behavior.
`;

function usage(): never {
	console.error("usage: project-public-config [--source <repo>] [--revision <commit>] <destination>");
	process.exit(2);
}

function parseArgs(argv: string[]): Options {
	let source = process.cwd();
	let revision = "HEAD";
	let destination: string | undefined;

	for (let index = 0; index < argv.length; index++) {
		const argument = argv[index];
		if (argument === "--source" || argument === "--revision") {
			const value = argv[++index];
			if (!value) usage();
			if (argument === "--source") source = value;
			else revision = value;
			continue;
		}
		if (argument === "--help" || argument === "-h") usage();
		if (argument.startsWith("-") || destination) usage();
		destination = argument;
	}

	if (!destination) usage();
	return {
		destination: resolve(destination),
		revision,
		source: resolve(source),
	};
}

function git(source: string, args: string[]): Buffer {
	const result = Bun.spawnSync({
		cmd: ["git", "-C", source, ...args],
		maxBuffer: 64 * 1024 * 1024,
	});
	if (result.exitCode !== 0) {
		const detail = result.stderr.toString("utf8").trim();
		throw new Error(detail || `git ${args[0]} exited ${result.exitCode}`);
	}
	return Buffer.from(result.stdout);
}

function listTree(source: string, commit: string): TreeEntry[] {
	const paths = [...EXACT_PATHS, ...TREE_PREFIXES].sort();
	const raw = git(source, ["ls-tree", "-rz", "--full-tree", commit, "--", ...paths]);
	return raw
		.toString("utf8")
		.split("\0")
		.filter(Boolean)
		.map(record => {
			const separator = record.indexOf("\t");
			if (separator < 0) throw new Error(`invalid git tree record: ${record}`);
			const [mode, type, oid] = record.slice(0, separator).split(" ");
			if (type !== "blob" || !mode || !oid) throw new Error(`unsupported git tree record: ${record}`);
			return { mode, oid, path: record.slice(separator + 1) };
		});
}

function isIncludedPath(path: string): boolean {
	if (EXACT_PATHS.has(path)) return true;
	return TREE_PREFIXES.some(prefix => path.startsWith(`${prefix}/`));
}

function isExcludedPath(path: string): boolean {
	const parts = path.toLowerCase().split("/");
	return parts.some(part => EXCLUDED_PATH_PARTS.has(part));
}

function assertRelativePath(path: string): void {
	if (!path || isAbsolute(path) || path.split("/").some(part => part === "" || part === "." || part === "..")) {
		throw new Error(`unsafe projection path: ${path}`);
	}
}

function objectValue(value: unknown, label: string): Record<string, unknown> {
	if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error(`${label} must be an object`);
	return value as Record<string, unknown>;
}

function encodeJson(value: unknown): string {
	return `${JSON.stringify(value, null, 2)}\n`;
}

function removeGeneratedHooks(value: unknown): unknown {
	if (Array.isArray(value)) return value.map(removeGeneratedHooks);
	if (!value || typeof value !== "object") return value;

	const input = value as Record<string, unknown>;
	const output: Record<string, unknown> = {};
	for (const [key, child] of Object.entries(input)) {
		if (key === "hooks" && Array.isArray(child)) {
			const hooks = child.filter(hook => {
				if (!hook || typeof hook !== "object" || Array.isArray(hook)) return true;
				return !String((hook as Record<string, unknown>).command ?? "").includes("herdr-agent-state.sh");
			});
			if (hooks.length) output[key] = hooks.map(removeGeneratedHooks);
			continue;
		}
		output[key] = removeGeneratedHooks(child);
	}
	return output;
}

function projectClaudeSettings(text: string): string {
	const source = objectValue(JSON.parse(text), ".claude/settings.json");
	const output: Record<string, unknown> = {};
	for (const key of ["$schema", "model", "statusLine", "enabledPlugins", "effortLevel", "skipDangerousModePermissionPrompt", "theme"]) {
		if (source[key] !== undefined) output[key] = source[key];
	}

	const environment = objectValue(source.env ?? {}, ".claude/settings.json env");
	output.env = Object.fromEntries(
		Object.entries(environment).filter(([key]) => ["API_TIMEOUT_MS", "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"].includes(key)),
	);

	const permissions = objectValue(source.permissions ?? {}, ".claude/settings.json permissions");
	const allow = Array.isArray(permissions.allow)
		? permissions.allow.filter(item => typeof item === "string" && !PRIVATE_LINE_TOKENS.some(token => item.includes(token)))
		: [];
	output.permissions = { allow };

	const overrides = objectValue(source.skillOverrides ?? {}, ".claude/settings.json skillOverrides");
	output.skillOverrides = Object.fromEntries(Object.entries(overrides).filter(([name]) => SKILL_NAMES.has(name)));
	if (source.hooks !== undefined) output.hooks = removeGeneratedHooks(source.hooks);
	return encodeJson(output);
}

function projectZedSettings(text: string): string {
	const source = objectValue(Bun.JSONC.parse(text), ".config/zed/settings.json");
	for (const key of ["language_models", "ssh_connections", "edit_predictions", "proxy", "server_url"]) delete source[key];

	const agent = objectValue(source.agent ?? {}, "Zed agent settings");
	delete agent.favorite_models;
	source.agent = agent;

	const servers = objectValue(source.agent_servers ?? {}, "Zed agent servers");
	source.agent_servers = Object.fromEntries(
		Object.entries(servers).filter(([name]) => ["claude-acp", "codex-acp", "grok-build"].includes(name)),
	);

	const lsp = objectValue(source.lsp ?? {}, "Zed LSP settings");
	delete lsp["shadowtree-lsp"];
	source.lsp = lsp;
	return encodeJson(source);
}

function projectToml(
	text: string,
	topLevelKeys: Set<string>,
	allowedSections: (section: string) => boolean,
): string {
	Bun.TOML.parse(text);
	const output: string[] = [];
	let keepSection = false;
	for (const line of text.split(/\r?\n/)) {
		const header = line.match(/^\s*\[\[?([^\]]+)\]\]?\s*(?:#.*)?$/);
		if (header) {
			keepSection = allowedSections(header[1]);
			if (keepSection) output.push(line);
			continue;
		}
		if (keepSection) {
			output.push(line);
			continue;
		}
		const assignment = line.match(/^\s*([A-Za-z0-9_-]+)\s*=/);
		if (assignment && topLevelKeys.has(assignment[1])) output.push(line);
	}
	const projected = `${output.join("\n").trim()}\n`;
	Bun.TOML.parse(projected);
	return projected;
}

