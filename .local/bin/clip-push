#!/bin/sh
# version: 1.3.1
# Send the clipboard image to a remote clip-recv over Taildrop.
#   clip-push           read the clipboard (pngpaste, wl-paste, or xclip)
#   clip-push --stdin   read PNG from stdin (for wl-paste --watch)
#   clip-push --changed quietly skip a non-image clipboard (for the macOS clip-watch)
#   clip-push --target  print the target (setup.sh uses it to find the receiver host)
# The target is $CLIP_PUSH_TARGET, defaulting to the receiver's tailnet address.
set -eu
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH:/Applications/Tailscale.app/Contents/MacOS"

log() {
	printf 'clip-push: %s\n' "$*" >&2
}

mode=${1:-}
target=${CLIP_PUSH_TARGET:-100.64.0.1}
[ "$mode" != --target ] || { printf '%s\n' "$target"; exit 0; }

# Every clipboard change spawns a push, so keep the scratch PNGs in one directory
# and sweep it: the traps clear the ordinary exits, the sweep clears whatever a
# kill -9 (or the watchdog below) left behind, so /tmp cannot grow without bound.
tmpdir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/clip-push"
mkdir -p "$tmpdir"
find "$tmpdir" -type f -mmin +10 -exec rm -f {} + 2>/dev/null || :

png=$(mktemp "$tmpdir/clip.XXXXXX") || exit 1
trap 'rm -f "$png"' EXIT
trap 'exit 143' HUP INT TERM

ts=$(command -v tailscale || command -v Tailscale) || { log "tailscale is not installed"; exit 1; }

if [ "$mode" = --stdin ]; then
	cat >"$png"
elif command -v pngpaste >/dev/null 2>&1; then
	pngpaste - >"$png" 2>/dev/null || :
elif [ -n "${WAYLAND_DISPLAY:-}" ]; then
	wl-paste --list-types 2>/dev/null | grep -qx image/png && wl-paste --type image/png >"$png"
else
	xclip -selection clipboard -t TARGETS -o 2>/dev/null | grep -qx image/png &&
		xclip -selection clipboard -t image/png -o >"$png"
fi

# A text clipboard is normal for --stdin and --changed, which run on every change.
if [ ! -s "$png" ]; then
	[ -z "$mode" ] || exit 0
	log "the clipboard has no PNG image"
	exit 1
fi

# Bound the push so an unreachable remote cannot hold back the paste.
"$ts" file cp --name=clip.png - "$target:" <"$png" &
push=$!
(sleep 5 && kill "$push" 2>/dev/null) &
watchdog=$!
status=0
wait "$push" || status=$?
kill "$watchdog" 2>/dev/null || :
[ "$status" -eq 0 ] || { log "push to $target failed (exit $status)"; exit "$status"; }
