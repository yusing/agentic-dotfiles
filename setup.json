{
  "version": 2,
  "groups": {
    "core": "Minimal non-interactive base (git, curl, bash, search, JSON/YAML, rtk)",
    "shell": "Interactive shells (fish, zsh + plugins), prompt, and terminal TUI utilities",
    "clipboard": "Host clipboard utilities (xclip, wl-clipboard, pngpaste)",
    "agent-core": "Agent runtime infrastructure (skills-mgr, graphify, scriptc, ctx7, git-agent, shadowtree)",
    "agent-clis": "Coding agent CLIs (Claude Code, Devin, Grok, Antigravity, Kilocode)",
    "lint": "Headless code quality, formatting, security scanning, and task runners",
    "dev-tui": "Interactive developer tools and local CI/network helpers",
    "build": "Native C/C++ build prerequisites and libraries",
    "c": "C/C++, LLVM/Clang, Meson, Tree-sitter, and Bazel",
    "go": "Go toolchain, linters, and Go development tools",
    "rust": "Rust toolchain (rustup), rust-analyzer, sccache, and cargo-sweep",
    "js": "JavaScript/TypeScript runtimes (Bun, Node, pnpm) and linters",
    "python": "Python, uv, ruff, pyright, and rich",
    "php": "PHP and Composer",
    "ruby": "Ruby",
    "swift": "SwiftLint",
    "lua": "Luacheck",
    "browser": "Headless browser automation (agent-browser and Lightpanda)",
    "chromium": "System runtime libraries for local Chromium on Linux",
    "webkit": "WebKitGTK runtime libraries on Linux",
    "mosh": "Mosh fork with image paste",
    "docker": "Docker CLI, Docker Sandboxes, binfmt, and hadolint",
    "db": "PostgreSQL 18",
    "media": "FFmpeg, ImageMagick, yt-dlp, Graphviz, and Apprise",
    "fonts": "Nerd Fonts and IBM Plex Sans"
  },
  "profiles": {
    "core": ["core"],
    "agent": ["core", "agent-core", "lint"],
    "agents": ["agent-core", "agent-clis"],
    "dev": ["core", "shell", "clipboard", "agent-core", "agent-clis", "lint", "dev-tui", "build", "c", "go", "rust", "js", "python", "browser", "chromium", "mosh"],
    "full": ["*"]
  },
