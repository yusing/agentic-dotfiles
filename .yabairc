#!/usr/bin/env sh

# 1. LOAD SCRIPTING ADDITION (Requires SIP disabled)
sudo yabai --load-sa
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
# Force new windows to move to the currently focused display
#yabai -m signal --add event=window_created action='yabai -m window $YABAI_WINDOW_ID --display $(yabai -m query --displays --display | jq ".index")'

# 2. LAYOUT SETTINGS
yabai -m config layout bsp
yabai -m config auto_balance on
yabai -m config window_placement second_child

# 3. VISUALS (Leveraging SIP)
yabai -m config window_shadow float      # Cleaner look
yabai -m config window_opacity on        # Enable transparency
yabai -m config active_window_opacity 0.98
yabai -m config normal_window_opacity 0.9
yabai -m config skip_window_focus_animation on

# 4. PADDING
yabai -m config top_padding    4
yabai -m config bottom_padding 4
yabai -m config left_padding   12
yabai -m config right_padding  4
yabai -m config window_gap     4

# 5. MOUSE
yabai -m config mouse_follows_focus on

# These apps do not expose a reliable resizable window lifecycle to macOS.
# Kaku collapses its window to 0x0 instead of destroying it when dismissed.
# yabai -m rule --add app='^Kaku$' manage=off
yabai -m rule --add app='^trgame\.exe$' manage=off

# Rules are added after yabai has observed existing windows during startup.
yabai -m rule --apply
