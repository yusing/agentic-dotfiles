# Kaku Dark, matching the corrected WezTerm appearance.
# Native Ghostty shortcuts and shell integration remain in use.
font-family = JetBrains Mono
font-family = JetBrainsMono Nerd Font Mono
font-style = Medium
font-family-bold = JetBrains Mono
font-style-bold = Medium
font-style-italic = false
font-family-bold-italic = JetBrains Mono
font-style-bold-italic = Medium
# Same point size as WezTerm: 15 / 1.1^3. Rendering can differ by terminal/DPI.
font-size = 11.269722
font-feature = -calt
font-feature = -clig
font-feature = -liga
font-thicken = true
adjust-cell-height = 10%

background = #15141b
foreground = #d5d4d6
background-opacity = 1
background-blur = false
window-colorspace = srgb
window-theme = dark
minimum-contrast = 3
cursor-color = #8e6ad9
cursor-text = #15141b
cursor-style = bar
cursor-style-blink = true
# Kaku's 55% purple selection composited over its opaque dark background.
selection-background = #584384
selection-foreground = #d5d4d6
palette = 0=#15141b
palette = 1=#d85d5d
palette = 2=#58d8ad
palette = 3=#daae76
palette = 4=#68afda
palette = 5=#8e6ad9
palette = 6=#58d8ad
palette = 7=#d5d4d6
palette = 8=#6d6d6d
palette = 9=#d85d5d
palette = 10=#58d8ad
palette = 11=#daae76
palette = 12=#90c9e6
palette = 13=#8e6ad9
palette = 14=#58d8ad
palette = 15=#d5d4d6
unfocused-split-opacity = 1
split-divider-color = #29263c

# Ghostty padding scales with DPI: 13 logical points is ~26px at 2x.
window-padding-x = 13
window-padding-y = 13,0
window-padding-balance = false
window-width = 110
window-height = 22
maximize = false
window-decoration = server
copy-on-select = clipboard
confirm-close-surface = true

# Keep the existing Ghostty-specific integrations.
notify-on-command-finish = unfocused
shell-integration = fish
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path
title-report = true
