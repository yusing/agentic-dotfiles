{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teardown:schema:1.0",
  "title": "Teardown document",
  "description": "Structured, renderer-owned visual explanations. All objects reject extra fields.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "type": {
      "enum": [
        "module-teardown",
        "concept-guide",
        "comparison",
        "walkthrough"
      ]
    },
    "eyebrow": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "lede": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      },
      "minItems": 1,
      "maxItems": 80
    }
  },
  "required": [
    "schema_version",
    "type",
    "title",
    "lede",
    "blocks"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "label",
        "location"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,39}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "from",
        "to",
        "label"
      ],
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "properties": {
        "type": {
          "const": "section"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      },
      "required": [
        "type",
        "title"
      ],
      "additionalProperties": false
    },
    "prose": {
      "type": "object",
      "properties": {
        "type": {
          "const": "prose"
        },
        "body_md": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "required": [
        "type",
        "body_md"
      ],
      "additionalProperties": false
    },
    "callout": {
      "type": "object",
      "properties": {
        "type": {
          "const": "callout"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "tone": {
          "enum": [
            "note",
            "tip",
            "warning",
            "danger"
          ]
        },
        "body_md": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "required": [
        "type",
        "title",
        "tone",
        "body_md"
      ],
      "additionalProperties": false
    },
    "capability-grid": {
      "type": "object",
      "properties": {
        "type": {
          "const": "capability-grid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "status": {
                "enum": [
                  "supported",
                  "unsupported",
                  "partial",
                  "unknown"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              }
            },
            "required": [
              "label",
              "status",
              "detail"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 12
        }
      },
      "required": [
        "type",
        "cells"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "type": {
          "const": "evidence"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "confidence": {
          "enum": [
            "observed",
            "inferred",
            "unknown"
          ]
        },
        "text_md": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 0,
          "maxItems": 20
        }
      },
      "required": [
        "type",
        "confidence",
        "text_md",
        "sources"
      ],
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "properties": {
        "type": {
          "const": "comparison"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "body_md": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              }
            },
            "required": [
              "label",
              "body_md"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 4
        }
      },
      "required": [
        "type",
        "title",
        "columns"
      ],
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "properties": {
        "type": {
          "const": "table"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "minItems": 1,
          "maxItems": 8
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "minItems": 1,
            "maxItems": 8
          },
          "minItems": 1,
          "maxItems": 100
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "type",
        "title",
        "columns",
        "rows"
      ],
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "properties": {
        "type": {
          "const": "flow"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 1,
          "maxItems": 12
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "type",
        "title",
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "sequence": {
      "type": "object",
      "properties": {
        "type": {
          "const": "sequence"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 6
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              },
              "kind": {
                "enum": [
                  "request",
                  "response",
                  "event"
                ]
              }
            },
            "required": [
              "from",
              "to",
              "label",
              "kind"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 20
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "type",
        "title",
        "participants",
        "steps"
      ],
      "additionalProperties": false
    },
    "state-machine": {
      "type": "object",
      "properties": {
        "type": {
          "const": "state-machine"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "kind": {
                "enum": [
                  "initial",
                  "normal",
                  "terminal"
                ]
              }
            },
            "required": [
              "id",
              "label",
              "kind"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 12
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "type",
        "title",
        "states",
        "transitions"
      ],
      "additionalProperties": false
    },
    "code": {
      "type": "object",
      "properties": {
        "type": {
          "const": "code"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "language": {
          "enum": [
            "text",
            "javascript",
            "typescript",
            "python",
            "go",
            "rust",
            "shell",
            "json",
            "sql",
            "css",
            "html",
            "diff",
            "pseudocode"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40000
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "type",
        "language",
        "code"
      ],
      "additionalProperties": false
    },
    "file-tree": {
      "type": "object",
      "properties": {
        "type": {
          "const": "file-tree"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "responsibility": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "path",
              "responsibility"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 60
        }
      },
      "required": [
        "type",
        "title",
        "entries"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "type": {
          "const": "metrics"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "context": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "label",
              "value",
              "context"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "required": [
        "type",
        "items"
      ],
      "additionalProperties": false
    },
    "checklist": {
      "type": "object",
      "properties": {
        "type": {
          "const": "checklist"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "status": {
                "enum": [
                  "done",
                  "todo",
                  "blocked"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "label",
              "status"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 40
        }
      },
      "required": [
        "type",
        "title",
        "items"
      ],
      "additionalProperties": false
    },
    "glossary": {
      "type": "object",
      "properties": {
        "type": {
          "const": "glossary"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "definition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "term",
              "definition"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 40
        }
      },
      "required": [
        "type",
        "title",
        "terms"
      ],
      "additionalProperties": false
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/section"
        },
        {
          "$ref": "#/$defs/prose"
        },
        {
          "$ref": "#/$defs/callout"
        },
        {
          "$ref": "#/$defs/capability-grid"
        },
        {
          "$ref": "#/$defs/evidence"
        },
        {
          "$ref": "#/$defs/comparison"
        },
        {
          "$ref": "#/$defs/table"
        },
        {
          "$ref": "#/$defs/flow"
        },
        {
          "$ref": "#/$defs/sequence"
        },
        {
          "$ref": "#/$defs/state-machine"
        },
        {
          "$ref": "#/$defs/code"
        },
        {
          "$ref": "#/$defs/file-tree"
        },
        {
          "$ref": "#/$defs/metrics"
        },
        {
          "$ref": "#/$defs/checklist"
        },
        {
          "$ref": "#/$defs/glossary"
        }
      ]
    }
  }
}
