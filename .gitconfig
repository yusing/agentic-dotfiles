[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[commit]
  gpgSign = true
[tag]
  gpgSign = true
[gpg]
  program = gpg
[init]
  defaultBranch = main
[core]
  pager = delta
  excludesfile = $HOME/.gitignore_global
[interactive]
  diffFilter = delta --color-only --show-syntax-themes
[diff]
  algorithm = histogram
  colorMoved = zebra
[delta]
  navigate = true
  line-numbers = true
  tabs = 4
  keep-plus-minus-markers = true
  features = catppuccin-mocha
[alias]
	# Use a temporary index so untracked files appear without changing the real staging area.
	diffstat = "!f() { prefix=${GIT_PREFIX:-.}; index=$(git rev-parse --git-path index) || return; tmpdir=$(mktemp -d \"${TMPDIR:-/tmp}/git-diffstat.XXXXXX\") || return; tmp=\"$tmpdir/index\"; trap 'rm -f \"$tmp\" \"$tmp.lock\"; rmdir \"$tmpdir\" 2>/dev/null' EXIT HUP INT TERM; if test -f \"$index\"; then cp \"$index\" \"$tmp\" || return; else GIT_INDEX_FILE=\"$tmp\" git read-tree --empty || return; fi; GIT_INDEX_FILE=\"$tmp\" git add -N -- . || return; cd \"$prefix\" || return; GIT_INDEX_FILE=\"$tmp\" git diff --shortstat \"$@\"; }; f"
	# Forward git diff arguments; production stats exclude common test and documentation paths.
	diffstat-prod = "!f() { cd \"${GIT_PREFIX:-.}\" || return; git diffstat \"$@\" ':(top,exclude,glob,icase)**/test/**' ':(top,exclude,glob,icase)**/tests/**' ':(top,exclude,glob,icase)**/__tests__/**' ':(top,exclude,glob,icase)**/spec/**' ':(top,exclude,glob,icase)**/specs/**' ':(top,exclude,glob,icase)**/__snapshots__/**' ':(top,exclude,glob,icase)**/doc/**' ':(top,exclude,glob,icase)**/docs/**' ':(top,exclude,glob,icase)**/documentation/**' ':(top,exclude,glob,icase)**/test_*' ':(top,exclude,glob,icase)**/*_test.*' ':(top,exclude,glob,icase)**/*.test.*' ':(top,exclude,glob,icase)**/*_spec.*' ':(top,exclude,glob,icase)**/*.spec.*' ':(top,exclude,glob,icase)**/*.md' ':(top,exclude,glob,icase)**/*.mdx' ':(top,exclude,glob,icase)**/*.rst' ':(top,exclude,glob,icase)**/*.adoc' ':(top,exclude,glob,icase)**/*.asciidoc' ':(top,exclude,glob,icase)**/README*' ':(top,exclude,glob,icase)**/CHANGELOG*' ':(top,exclude,glob,icase)**/CONTRIBUTING*'; }; f"

[delta "catppuccin-mocha"]
	blame-palette = "#1e1e2e #181825 #11111b #313244 #45475a"
	commit-decoration-style = "#6c7086" bold box ul
	dark = true
	file-decoration-style = "#6c7086"
	file-style = "#cdd6f4"
	hunk-header-decoration-style = "#6c7086" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#a6adc8"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#6c7086"
	line-numbers-minus-style = bold "#f38ba8"
	line-numbers-plus-style = bold "#a6e3a1"
	line-numbers-right-style = "#6c7086"
	line-numbers-zero-style = "#6c7086"
	# 35% red 65% base
	minus-emph-style = bold syntax "#694559"
	# 20% red 80% base
	minus-style = syntax "#493447"
	# 35% green 65% base
	plus-emph-style = bold syntax "#4e6356"
	# 20% green 80% base
	plus-style = syntax "#394545"
	map-styles = \
		bold purple => syntax "#5b4e74", \
		bold blue => syntax "#445375", \
		bold cyan => syntax "#446170", \
		bold yellow => syntax "#6b635b"
	# Should match the name of the bat theme
	syntax-theme = Catppuccin Mocha
