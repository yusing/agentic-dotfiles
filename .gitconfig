[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[commit]
  gpgSign = true
[tag]
  gpgSign = true
[gpg]
  program = gpg
[init]
  defaultBranch = main
[core]
  pager = hunk pager
  excludesfile = $HOME/.gitignore_global
[alias]
	# Use a temporary index so untracked files appear without changing the real staging area.
	diffstat = "!f() { prefix=${GIT_PREFIX:-.}; index=$(git rev-parse --git-path index) || return; tmpdir=$(mktemp -d \"${TMPDIR:-/tmp}/git-diffstat.XXXXXX\") || return; tmp=\"$tmpdir/index\"; trap 'rm -f \"$tmp\" \"$tmp.lock\"; rmdir \"$tmpdir\" 2>/dev/null' EXIT HUP INT TERM; if test -f \"$index\"; then cp \"$index\" \"$tmp\" || return; else GIT_INDEX_FILE=\"$tmp\" git read-tree --empty || return; fi; if test \"$1\" = --; then shift; fi; if test \"$#\" -eq 0; then set -- .; else cd \"$prefix\" || return; fi; GIT_INDEX_FILE=\"$tmp\" git add -N -- \"$@\" && GIT_INDEX_FILE=\"$tmp\" git diff --shortstat -- \"$@\"; }; f"
