  "skillOverrides": {
    "build-code-skeleton": "user-invocable-only",
    "deliver-vertical-slice": "user-invocable-only",
    "new-project": "user-invocable-only",
    "using-pjdoc": "user-invocable-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "'$HOME/.codex/hooks/check_project' --without-git",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 '$HOME/.codex/hooks/skills_mgr_inventory.py'",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 '$HOME/.codex/hooks/skills_mgr_inventory.py'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 '$HOME/.codex/hooks/skills_mgr_inventory.py'",
            "timeout": 5
          }
        ]
      }
    ]
  }
