  "skillOverrides": {},
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/bin/check_project --without-git",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/bin/skills_mgr_inventory",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "cat $HOME/.claude/instructions/MAIN.md",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/bin/skills_mgr_inventory --subagent-start",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "jq -Rs '{hookSpecificOutput: {hookEventName: \"SubagentStart\", additionalContext: .}}' $HOME/.claude/instructions/SUBAGENT.md",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "(^|[._])(apply_patch|exec_command|write_stdin|exec|wait)$|^(Bash|Edit|Write|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/bin/graphify_update",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
