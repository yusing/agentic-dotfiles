{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|run_terminal_command|Grep|grep|Search|search|Glob|ListDir|list_dir)$",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.grok/hooks/bin/skills_path_guard",
            "timeout": 5,
            "statusMessage": "Checking for home skills path access"
          }
        ]
      }
    ]
  }
}
