{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.grok/hooks/bin/adapt_codex_hook $HOME/.codex/hooks/bin/check_project",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.grok/hooks/bin/adapt_codex_hook $HOME/.codex/hooks/bin/skills_mgr_inventory",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.grok/hooks/bin/adapt_codex_hook $HOME/.codex/hooks/bin/skills_mgr_inventory",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.grok/hooks/bin/adapt_codex_hook $HOME/.codex/hooks/bin/skills_mgr_inventory",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write|search_replace|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.grok/hooks/bin/adapt_codex_hook generated_code_guard",
            "timeout": 5,
            "statusMessage": "Checking for generated Go files"
          }
        ]
      },
      {
        "matcher": "^(Bash|run_terminal_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.grok/hooks/bin/adapt_codex_hook bash_pre_tool_use",
            "timeout": 5,
            "statusMessage": "Checking Bash command policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.grok/hooks/bin/adapt_codex_hook go_guidelines",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
